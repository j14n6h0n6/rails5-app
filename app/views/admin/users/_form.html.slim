- if user.errors.present?
  #error_explanation.alert.alert-danger.alert-dismissible.fade.show role="alert"
    strong 入力内容を確認してください
    ul.mb-0.mt-2
      - user.errors.full_messages.each do |message|
        li= message
    button.btn-close type="button" data-bs-dismiss="alert" aria-label="閉じる"

= form_with model: [:admin, @user], local: true do |f|
  .mb-3
    = f.label :name, '名前'
    = f.text_field :name, class: 'form-control'
  .mb-3
    = f.label :email, 'メールアドレス'
    = f.email_field :email, class: 'form-control'
  .mb-3
    = f.label :admin, '管理者権限', class: 'form-label d-block'
    = f.check_box :admin, class: 'form-check-input'
  .mb-3
    = f.label :password, 'パスワード'
    = f.password_field :password, class: 'form-control'
  .mb-3
    = f.label :password_confirmation, 'パスワード(確認)'
    = f.password_field :password_confirmation, class: 'form-control'
  .mb-3
    = f.submit '登録', class: 'btn btn-primary'
