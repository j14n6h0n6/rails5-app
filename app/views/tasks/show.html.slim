h1 タスクの詳細

.nav.justify-content-end.mb-3
  = link_to '一覧', tasks_path, class: 'nav-link'
table.table.table-hover
  tbody
    tr
      th scope="row"  = Task.human_attribute_name(:id)
      td = @task.id
    tr
      th scope="row" = Task.human_attribute_name(:name)
      td = @task.name
    tr
      th scope="row" = Task.human_attribute_name(:description)
      td = simple_format(h(@task.description), {}, sanitize: false, wrapper_tag: "div")
    tr
      th scope="row" = Task.human_attribute_name(:created_at)
      td = @task.created_at
    tr
      th scope="row"  = Task.human_attribute_name(:updated_at)
      td = @task.updated_at

= link_to '編集', edit_task_path, class: 'btn btn-outline-primary me-2'
= link_to '削除', @task, method: :delete, data: { confirm: "タスク「#{@task.name}」を削除します。よろしいですか？" }, class: 'btn btn-outline-danger'
